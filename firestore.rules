rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isChatMember(chatId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    // Registered user profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        !('privateKey' in request.resource.data) && !('e2eePrivateKey' in request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !('privateKey' in request.resource.data) && !('e2eePrivateKey' in request.resource.data)) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'fcmToken', 'typingTo'])
      );
      allow delete: if false;

      // Strictly Private Nicknames: ONLY the owner can read or write!
      match /privateNicknames/{targetUid} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      match /nicknames/{targetUid} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Personal chat preferences: ONLY the owner can read or write!
      match /chatPreferences/{chatId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Follow relationships & Symmetric Shared Relationships
    match /relationships/{relationshipId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        resource.data.user1 == request.auth.uid ||
        resource.data.user2 == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.fromUid == request.auth.uid ||
        request.resource.data.user1 == request.auth.uid ||
        request.resource.data.user2 == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        resource.data.user1 == request.auth.uid ||
        resource.data.user2 == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        resource.data.user1 == request.auth.uid ||
        resource.data.user2 == request.auth.uid
      );
    }

    // Chats (1-to-1 and group)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        
        allow create: if isChatMember(chatId) && 
          request.resource.data.senderId == request.auth.uid;
        
        allow update: if isChatMember(chatId) && (
          // Sender editing text, poll options, or deleting for everyone
          (resource.data.senderId == request.auth.uid) ||
          // Chat participant marking read, delivered, deleting for themselves, poll voting, toggling reactions, or opening gift
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deliveredTo', 'deletedBy', 'reactions', 'pollVotes', 'isGiftOpened', 'openedAt', 'giftOpenedBy']))
        );
        
        allow delete: if isChatMember(chatId) && resource.data.senderId == request.auth.uid;
      }

      // Shared Playlists subcollection
      match /playlists/{playlistId} {
        allow read, write: if isChatMember(chatId);
      }
    }

    // Scheduled Messages (Time Capsule)
    match /scheduledMessages/{messageId} {
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // Notifications queue for backend processing
    match /notifications/{notificationId} {
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // User reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Statuses / Updates
    match /statuses/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Anonymous Q&A questions subcollection
      match /questions/{questionId} {
        allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/statuses/$(statusId)).data.userId == request.auth.uid
        );
        allow update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/statuses/$(statusId)).data.userId == request.auth.uid
        );
      }
    }

    // Communities
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // Lock down any unmatched collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
